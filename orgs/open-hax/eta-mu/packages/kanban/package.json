{
  "name": "@open-hax/kanban-legacy",
  "version": "0.1.2",
  "private": false,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./board.js": {
      "types": "./dist/board.d.ts",
      "import": "./dist/board.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./content-parser.js": {
      "types": "./dist/content-parser.d.ts",
      "import": "./dist/content-parser.js"
    },
    "./tasks.js": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js"
    },
    "./task-writeback.js": {
      "types": "./dist/task-writeback.d.ts",
      "import": "./dist/task-writeback.js"
    }
  },
  "bin": {
    "openhax-kanban": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "examples"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "clean": "rm -rf dist",
    "snapshot": "node dist/cli.js board snapshot",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "sync:trello": "node dist/cli.js sync trello",
    "build:web": "vite build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.14",
    "vitest": "^2.1.1"
  }
}
