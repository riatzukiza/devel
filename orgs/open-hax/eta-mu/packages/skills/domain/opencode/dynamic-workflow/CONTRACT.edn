;; ημ.skill/dynamic-workflow@0.1.0
;; Analogue of Claude Code's Dynamic Workflows research preview.
;; Teaches the agent to synthesise and execute an orchestration SCRIPT
;; via the opencode SDK rather than handling a large task in a single turn.

(skill-contract
  (name "dynamic-workflow")
  (v "ημ.skill/dynamic-workflow@0.1.0")

  (intent
    "Given a task too large for a single-agent turn — multi-file refactor,
     codebase audit, cross-package migration, signal sweep — the agent MUST:
       1. Write a TypeScript orchestration script (workflow.ts) that uses
          the opencode SDK to spin up N subagent sessions.
       2. Commit that script to the repo before executing it (fork tax).
       3. Execute the script, collect subagent outputs, and cross-check them.
       4. Emit a single verified artifact (patch, report, or JSON receipt).
     The plan lives in executable code, not in the model's context window.")

  (activation
    (priority 62)
    (explicit ["skill:dynamic-workflow"])
    (triggers
      ["dynamic workflow" "orchestration script" "parallel subagents"
       "fan out agents" "workflow script" "multi-agent orchestration"
       "run agents in parallel" "large task" "too big for one turn"
       "ultracode" "codebase-wide" "cross-package sweep"])
    (autoload false))

  (governance
    (touch-layer :semi-stable)
    (non-override [:mission :directives :safety :license :output-shape])
    (requires-user-approval true)   ;; writes real files and spawns sessions
    (blast-radius :workspace))

  (effects
    (writes true)           ;; emits workflow.ts + receipt
    (network false)
    (commits true)          ;; commits the script before running it
    (spawns-agents true))

  (protocol
    ;; ── Phase 0 : Perceive ─────────────────────────────────────────────
    (phase-0-perceive
      "Before writing a single line of code:"
      "  a. Restate the task in ≤ 5 bullets (Facts vs Interpretations)."
      "  b. Identify the work units: what is the smallest independently-testable slice?"
      "  c. Choose a parallelism budget N (default: 4; max: 16 per run)."
      "  d. Name the output artifact: patch | json-report | markdown-report | receipt.")

    ;; ── Phase 1 : Write the orchestration script ───────────────────────
    (phase-1-script
      (location "agents/<workflow-name>/workflow.ts")
      (template
        """
import { App } from '@opencode-ai/sdk'

const TASK_SLICES: string[] = [
  // TODO: generated by the agent from phase-0 analysis
]

async function runSlice(app: App, slice: string): Promise<unknown> {
  const session = await app.session.create({
    model: 'claude-opus-4-5',
    systemPrompt: [
      'You are a focused sub-agent. Complete ONLY the task given.',
      'Emit structured JSON to stdout when done.',
    ].join(' '),
  })
  const result = await session.run(`Task:\n${slice}`)
  await session.dispose()
  return result
}

async function crossCheck(results: unknown[]): Promise<void> {
  // Verifier subagent: compare results, surface conflicts.
  const app = await App.create()
  const verifier = await app.session.create({
    model: 'claude-opus-4-5',
    systemPrompt: 'You are a verifier. Find conflicts and confirm the results agree.'
  })
  await verifier.run(`Results to verify:\n${JSON.stringify(results, null, 2)}`)
  await verifier.dispose()
}

async function main() {
  const app = await App.create()
  const results = await Promise.all(TASK_SLICES.map(s => runSlice(app, s)))
  await crossCheck(results)
  await Bun.write(`receipts/${new Date().toISOString()}-workflow.json`,
    JSON.stringify({ slices: TASK_SLICES, results }, null, 2))
}

main().catch(console.error)
        """))

    ;; ── Phase 2 : Fork-tax commit ──────────────────────────────────────
    (phase-2-fork-tax
      "Commit the script BEFORE running it:"
      "  git add agents/<name>/workflow.ts && git commit -m 'chore(workflow): <name> orchestration script'"
      "This ensures the plan is durable even if execution fails.")

    ;; ── Phase 3 : Execute ─────────────────────────────────────────────
    (phase-3-execute
      "Run: bun agents/<name>/workflow.ts"
      "Monitor: stream subagent stdout into a local log buffer."
      "Abort rule: if any subagent emits a non-JSON line that starts with ERROR:, cancel the run."
      "Token budget: prefer claude-haiku for leaf workers; reserve opus for orchestrator and verifier.")

    ;; ── Phase 4 : Cross-check and receipt ─────────────────────────────
    (phase-4-verify
      "After all slices complete:"
      "  1. Run the crossCheck verifier session."
      "  2. Write receipts/<ISO-timestamp>-<name>.json."
      "  3. Commit the receipt: git commit -m 'chore(receipt): <name> workflow result'."
      "  4. Surface a diff-summary or report to the user.")

    ;; ── Guard rails ───────────────────────────────────────────────────
    (guards
      (max-concurrent-agents 16)
      (max-total-agents-per-run 64)
      (require-user-approval-above-n 8)
      (no-force-push true)
      (receipts-are-append-only true)
      "Never mutate shared state across parallel agents — use isolated checkouts or"
      " read-only file access for workers; only the orchestrator may write."))

  (examples
    (example
      (trigger "Run a security audit across all packages in parallel")
      (workflow-name "security-audit")
      (slices
        ["packages/ai: scan for hardcoded secrets"
         "packages/agent: scan for unsafe eval / exec"
         "packages/mom: scan for unvalidated external inputs"
         "services/agentd: scan for open CORS and missing auth middleware"])
      (artifact "json-report"))

    (example
      (trigger "Migrate all Reagent components to use the new signal-contracts shape")
      (workflow-name "reagent-signal-migration")
      (slices
        ["packages/opencode-reactant/src/views"
         "packages/opencode-reactant/src/sidebar"
         "packages/web-ui/src/components"
         "packages/tui/src"])
      (artifact "patch")))

  (output
    (must-include
      ["A committed workflow.ts before any execution begins"
       "A receipts/<timestamp>-<name>.json after execution"
       "A diff-summary or report surfaced to the user"])))
