{
  "name": "@open-hax/eta-mu-github",
  "version": "0.1.2",
  "private": false,
  "description": "Pi-based GitHub automation bot and review gate for PRs, issues, and mentions.",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "eta-mu-github": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "pnpm --dir ../eta-mu-runtime build",
    "pretest": "pnpm --dir ../eta-mu-runtime build",
    "pretypecheck": "pnpm --dir ../eta-mu-runtime build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@open-hax/eta-mu-runtime": "workspace:*",
    "@open-hax/eta-mu-ai": "workspace:*",
    "@open-hax/eta-mu-cli": "workspace:*",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@10.14.0"
}
