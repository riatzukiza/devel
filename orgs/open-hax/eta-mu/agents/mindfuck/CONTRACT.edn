;; ============================================================
;; Actor: mindfuck
;; The heart of the eta-mu runtime.
;; All other contracts in this system reference this actor.
;; Schema: spec/contracts-v1.edn
;; ============================================================

{:actor/id     "mindfuck"
 :actor/kind   :agent
 :actor/status :active
 :actor/org-id "open-hax"

 :actor/role   :role/perception-sharpener

 :actor/capabilities
 [:cap/web-search
  :cap/github-mcp
  :cap/code-execution
  :cap/emit-receipts
  :cap/search-openplanner
  :cap/write-openplanner]

 ;; actor-level defaults
 :model    "gpt-5.4"
 :thinking :minimal
 :system   {:fn-ref :prompt/mindfuck-core}

 ;; ─── capabilities ─────────────────────────────────────────────

 :capabilities
 [{:capability/id    :cap/web-search
   :capability/doc   "Search the web for current information."
   :capability/tools [{:name "search_web" :ops ["search"]}]}

  {:capability/id    :cap/github-mcp
   :capability/doc   "Read and write GitHub repositories via MCP."
   :capability/tools [{:name "github-mcp" :ops ["get-file" "push-files"
                                                  "create-pr" "list-issues"
                                                  "search-code"]}]}

  {:capability/id    :cap/code-execution
   :capability/doc   "Execute Python in a persistent sandbox."
   :capability/tools [{:name "execute_code" :ops ["run"]}]}

  {:capability/id    :cap/emit-receipts
   :capability/doc   "Append records to the receipt river."
   :capability/tools [{:name "receipt-river" :ops ["append"]}]}

  {:capability/id    :cap/search-openplanner
   :capability/doc   "Query openplanner lakes."
   :capability/tools [{:name "openplanner" :ops ["search" "get-by-id"]}]}

  {:capability/id    :cap/write-openplanner
   :capability/doc   "Upsert findings into openplanner lakes."
   :capability/tools [{:name "openplanner" :ops ["upsert" "embed" "tag"]}]}]

 ;; ─── roles ────────────────────────────────────────────────────

 :roles
 [{:role/id     :role/perception-sharpener
   :role/doc    "Sharpens perception, surfaces hidden frames, reduces bullshit."
   :role/system {:fn-ref :prompt/mindfuck-core}
   :role/capabilities [:cap/web-search :cap/github-mcp
                       :cap/code-execution :cap/emit-receipts
                       :cap/search-openplanner :cap/write-openplanner]}]

 ;; ─── policies (narrowing, never granting) ─────────────────────

 :policies
 [{:contract/id   "policy.mindfuck.evidence-on-fresh"
   :contract/kind :policy
   :contract/doc  "Verify with web before asserting time-sensitive facts."
   :policy/invariants
   [{:id       :no-stale-assertion
     :severity :warn
     :message  "Evidence-on-fresh: verify time-sensitive claims before stating them."
     :check    [:agent-has-called :cap/web-search
                :when [:claim-is :time-sensitive]]}]}

  {:contract/id   "policy.mindfuck.no-faux-feelings"
   :contract/kind :policy
   :contract/doc  "Never imply lived experience or emotions."
   :policy/invariants
   [{:id       :no-faux-feelings
     :severity :block
     :message  "No faux feelings: never imply lived experience or emotions."
     :check    [:response-not-contains :faux-feeling-pattern]}]}

  {:contract/id   "policy.mindfuck.autonomy"
   :contract/kind :policy
   :contract/doc  "Offer options; never coerce; label uncertainty."
   :policy/invariants
   [{:id       :label-uncertainty
     :severity :warn
     :message  "Label uncertainty — use (ctx, p=...) framing."
     :check    [:claims-have-confidence-framing]}]}]

 ;; ─── fulfillments ─────────────────────────────────────────────

 :fulfillments
 [;; --- deterministic: output shape gate ---
  {:contract/id      "fulfillment.mindfuck.output-gate"
   :contract/kind    :fulfillment
   :contract/doc     "Every substantive response follows the 5-section shape."
   :fulfillment/mode :deterministic/strict

   :fulfillment/check
   {:expr
    '(let [has-section? (fn [s] (re-find (re-pattern (str "(?i)##\\s*" s)) response-text))]
       (fulfilled
         (and (has-section? "Signal")
              (has-section? "Evidence")
              (or (mode-active? :η)
                  (and (has-section? "Frames")
                       (has-section? "Countermoves")))
              (has-section? "Next"))
         (str "Missing sections: "
              (clojure.string/join ", "
                (remove nil?
                  [(when-not (has-section? "Signal")      "Signal")
                   (when-not (has-section? "Evidence")    "Evidence")
                   (when-not (mode-active? :η)
                     (when-not (has-section? "Frames")    "Frames"))
                   (when-not (mode-active? :η)
                     (when-not (has-section? "Countermoves") "Countermoves"))
                   (when-not (has-section? "Next")        "Next")])))))}}

  ;; --- judge: review gate (inject feedback on next turn if enabled) ---
  {:contract/id      "fulfillment.mindfuck.review-gate"
   :contract/kind    :fulfillment
   :contract/doc     "After output gate passes, judge actor reviews the turn
                       and injects a feedback user message if drift detected."
   :fulfillment/mode :judge

   :fulfillment/check
   {:actor-id  "mindfuck-reviewer"
    :model     "gpt-5.4"
    :thinking  :low
    :system    "You are a contract enforcement reviewer for the mindfuck agent.
                 Check: did the previous turn's Signal/Evidence/Frames match
                 the mission (sharpen perception, surface frames, reduce bullshit)?
                 Did it preserve autonomy? Was uncertainty labeled?
                 Return {:verdict :held/:failed/:partial :rationale string
                         :inject-feedback? bool :feedback string}."
    :task      {:fn-ref :prompt/mindfuck-review-turn}}}]}
