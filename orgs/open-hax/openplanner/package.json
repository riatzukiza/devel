{
  "name": "@open-hax/openplanner",
  "version": "0.3.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm --filter @open-hax/garden-publication-components build && pnpm --filter @open-hax/openplanner-graph-claim-core build && pnpm --filter @open-hax/openplanner-translation-core build && pnpm --filter @open-hax/openplanner-store-cache build && pnpm --filter @open-hax/openplanner-document-hydration build && tsc",
    "start": "node dist/main.js",
    "dev": "tsc -w",
    "dev:watch:container": "sh ./scripts/dev-watch-container.sh",
    "lint": "eslint --config eslint.config.mjs .",
    "lint:strict": "eslint --config eslint.config.mjs . --max-warnings=0",
    "duplication:scan": "pnpm dlx jscpd@4.0.5 --config .jscpd.json --threshold 100",
    "duplication:check": "pnpm dlx jscpd@4.0.5 --config .jscpd.json --threshold 5",
    "lint:migration-risk": "eslint --config eslint.config.mjs src packages tests --format stylish",
    "test": "tsx --tsconfig tsconfig.json",
    "test:e2e:compact-viewgraph": "tsx --tsconfig tsconfig.json tests/e2e-compact-viewgraph.test.mjs",
    "test:e2e:semantic-edge-decay": "tsx --tsconfig tsconfig.json tests/e2e-semantic-edge-decay.test.mjs",
    "test:e2e:semantic-field-vexx": "tsx --tsconfig tsconfig.json tests/e2e-semantic-field-vexx.test.mjs",
    "test:e2e:graph-weaver-semantic-field": "tsx --tsconfig tsconfig.json tests/e2e-graph-weaver-semantic-field-overlay.test.mjs",
    "test:integration:edge-claims": "node --import tsx --test tests/integration-edge-claim-routes.test.mjs",
    "test:translation-core": "pnpm --filter @open-hax/openplanner-translation-core test"
  },
  "dependencies": {
    "@fastify/multipart": "^8.2.0",
    "@fastify/sensible": "^5.6.0",
    "@open-hax/garden-publication-components": "workspace:*",
    "@open-hax/openplanner-document-hydration": "workspace:*",
    "@open-hax/openplanner-graph-claim-core": "workspace:*",
    "@open-hax/openplanner-store-cache": "workspace:*",
    "@open-hax/openplanner-translation-core": "workspace:*",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.5.16",
    "fastify": "^4.27.0",
    "fastify-plugin": "^5.1.0",
    "kafkajs": "^2.2.4",
    "lmdb": "^3.4.2",
    "marked": "^18.0.0",
    "mongodb": "^7.1.1",
    "pino": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.0",
    "sentence-splitter": "^5.0.1",
    "shiki": "^3.2.0",
    "stream-chain": "^3.4.0",
    "stream-json": "^1.9.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unzipper": "^0.12.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8",
    "autoprefixer": "^10.4.27",
    "c8": "^10.1.3",
    "eslint": "^10.2.1",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-sonarjs": "^4.0.3",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.1",
    "ws": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.18"
    }
  },
  "license": "GPL-3.0-or-later"
}
